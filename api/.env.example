# Copiar para .env e preencher. Nunca comitar o .env real — ver .gitignore.

AMBIENTE=desenvolvimento

# Postgres — em desenvolvimento, o docker-compose já define isto pelo
# serviço `api`; este ficheiro serve para correr a API fora de Docker.
DATABASE_URL=postgresql+psycopg://jpa:jpa@localhost:5432/jpa

# JWT — gerar um valor real com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=trocar-por-um-segredo-gerado-a-serio
ACCESS_TOKEN_EXPIRA_MINUTOS=15
REFRESH_TOKEN_EXPIRA_DIAS=30

# Cloudflare R2 (compatível com S3) — storage de ficheiros
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=janelasparaalma
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Base pública por onde o bucket é servido (domínio ligado ao bucket, ou o
# https://pub-xxxx.r2.dev do R2). URL final de um ficheiro = {base}/{chave}.
R2_PUBLIC_BASE_URL=
# Validade (segundos) do URL de upload assinado entregue ao browser.
R2_UPLOAD_URL_EXPIRA_SEGUNDOS=300

# Resend (email transacional) — recuperação de password (ver
# api/app/core/email.py). Sem chave, o EmailSender real não é construído;
# em dev/testes usa-se sempre um EmailSender falso, nunca esta linha.
RESEND_API_KEY=
# Remetente das mensagens — em produção tem de ser um domínio verificado no
# Resend (ex.: noreply@janelasparaalma.com). "onboarding@resend.dev" só
# entrega à própria conta Resend, serve para testar antes do domínio estar pronto.
EMAIL_REMETENTE=onboarding@resend.dev

# URL base do frontend — só para montar o link de recuperação de password
# que vai por email. Em produção: https://janelasparaalma.com
FRONTEND_BASE_URL=http://localhost:8080

# Login com Google (Sign In With Google) — ver api/app/core/google_auth.py.
# ID do cliente OAuth criado em console.cloud.google.com/apis/credentials
# (tipo "Aplicação Web"). Não é secreto, mas fica em env var na mesma.
GOOGLE_CLIENT_ID=

# --- Validação instantânea do comprovativo do Premium ----------------------
# Ver api/app/services/validacao_comprovativo_service.py. Bucket R2 PRIVADO
# só para os PDFs dos comprovativos (nome e conta de quem pagou) -- nunca o
# bucket público acima. Vazio = a validação responde 503.
R2_BUCKET_COMPROVATIVOS=
# Preço do mês em Kz -- um comprovativo abaixo disto é rejeitado.
SUBSCRIPTION_PRICE_KZ=15000
# Conta oficial que recebe. Têm de ser os MESMOS dados que o site mostra
# (frontend/src/lib/pagamento.ts) -- se não baterem, todos os comprovativos
# são rejeitados por "destinatário não corresponde". Basta um dos três;
# vazios os três = a validação responde 503 (nunca aprova nada).
# IBAN: com ou sem pontos/espaços.
PAYMENT_DEST_IBAN="AO06.0040.0000.XXXX.XXXX.XXXX.X"
# Número do Multicaixa Express (9 dígitos, com ou sem +244).
PAYMENT_DEST_PHONE="9XXXXXXXX"
# Palavras do nome do titular, separadas por espaço (todas têm de aparecer).
PAYMENT_DEST_NAME_KEYWORDS="NOME_DO_LIDER"
# Só aceita comprovativos dos últimos N dias.
PAYMENT_MAX_AGE_DAYS=3
# Interruptor de emergência: false manda tudo para revisão manual.
PAYMENT_AUTO_APROVACAO=true
# /Producer dos PDFs do BAI Directo/Express, separados por vírgula. Vazio =
# não verificar. Preencher depois de ver os metadados de comprovativos reais
# no painel (Admin → Comprovativos → detalhe).
PAYMENT_PRODUCERS_CONFIAVEIS=
