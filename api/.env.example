# Copiar para .env e preencher. Nunca comitar o .env real — ver .gitignore.

AMBIENTE=desenvolvimento

# Postgres — em desenvolvimento, o docker-compose já define isto pelo
# serviço `api`; este ficheiro serve para correr a API fora de Docker.
DATABASE_URL=postgresql+psycopg://jpa:jpa@localhost:5432/jpa

# JWT — gerar um valor real com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=trocar-por-um-segredo-gerado-a-serio
ACCESS_TOKEN_EXPIRA_MINUTOS=15
REFRESH_TOKEN_EXPIRA_DIAS=30

# Cloudflare R2 (compatível com S3) — storage de ficheiros
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=janelasparaalma
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Base pública por onde o bucket é servido (domínio ligado ao bucket, ou o
# https://pub-xxxx.r2.dev do R2). URL final de um ficheiro = {base}/{chave}.
R2_PUBLIC_BASE_URL=
# Validade (segundos) do URL de upload assinado entregue ao browser.
R2_UPLOAD_URL_EXPIRA_SEGUNDOS=300

# URL público do frontend — usado para montar links absolutos em emails.
FRONTEND_BASE_URL=http://localhost:8080

# Google Identity Services — "Entrar com a Google". Criar em
# console.cloud.google.com → APIs & Services → Credenciais → OAuth client ID
# (tipo "Web application"). Não é segredo (vai para o frontend também).
GOOGLE_OAUTH_CLIENT_ID=

# Resend (https://resend.com) — email transacional. Criar conta, verificar
# domínio de envio, gerar API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Janelas Para a Alma <no-reply@janelasparaalma.org>
