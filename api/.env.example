# Copiar para .env e preencher. Nunca comitar o .env real — ver .gitignore.

AMBIENTE=desenvolvimento

# Postgres — em desenvolvimento, o docker-compose já define isto pelo
# serviço `api`; este ficheiro serve para correr a API fora de Docker.
DATABASE_URL=postgresql+psycopg://jpa:jpa@localhost:5432/jpa

# JWT — gerar um valor real com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=trocar-por-um-segredo-gerado-a-serio
ACCESS_TOKEN_EXPIRA_MINUTOS=15
REFRESH_TOKEN_EXPIRA_DIAS=30

# Cloudflare R2 (compatível com S3) — storage de ficheiros
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=janelasparaalma
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
