# Copiar para .env e preencher. Nunca comitar o .env real — ver .gitignore.

# URL base da API própria (FastAPI). Por omissão (não definida) → "/api",
# servido na mesma origem: em dev pelo proxy do Vite (vite.config.ts), em
# produção pelo rewrite de vercel.json. Só definir para apontar o dev
# directamente a uma API remota — nesse caso a API tem de ter essa origem em
# `frontend_origins`.
# VITE_API_URL=https://api.exemplo.com

# URL base da API de rastreio visual (janelas-scanner-api, repositório à
# parte, MediaPipe). É um serviço distinto da API própria acima, por isso
# tem a sua própria variável — nunca reutilizar VITE_API_URL para isto, ou
# sequestra-se o cliente da API própria (src/lib/apiClient.ts). Corre à
# parte da API própria (8000), por omissão na 8001 para não colidir.
# VITE_API_SCANNER_URL=http://localhost:8001/api/v1

# Login com Google (Sign In With Google) — ver Auth.tsx e
# api/app/core/google_auth.py. Mesmo ID do cliente OAuth configurado no
# lado da API (GOOGLE_CLIENT_ID) — não é secreto, corre no browser.
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Supabase — dívida em remoção (ver CLAUDE.md secção 11). As páginas ainda não
# migradas ainda importam o cliente Supabase; sem estas variáveis o
# `createClient()` rebenta à carga do módulo. O código já tem placeholders,
# por isso definir isto é opcional — só é preciso para exercitar de facto as
# páginas que ainda falam com o Supabase antigo.
# VITE_SUPABASE_URL=https://<projecto>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<chave-anon>
