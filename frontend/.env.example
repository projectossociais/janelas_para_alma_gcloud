# Copiar para .env e preencher. Nunca comitar o .env real — ver .gitignore.

# URL base da API própria (FastAPI). Por omissão (não definida) → "/api",
# servido na mesma origem: em dev pelo proxy do Vite (vite.config.ts), nos
# containers pelo NGINX. Só definir para apontar o dev directamente a uma
# API remota — nesse caso a API tem de ter essa origem em `frontend_origins`.
# VITE_API_URL=https://api.exemplo.com
