# Serve o build estático do frontend (SPA — qualquer rota desconhecida cai
# em index.html, o React Router é que decide) e reencaminha /api/ para o
# serviço da API.
#
# `.template` + directório `templates/`: a imagem oficial do NGINX substitui
# `${API_URL}` por uma variável de ambiente REAL do container no arranque
# (envsubst), antes de gerar o /etc/nginx/conf.d/default.conf definitivo.
# Isto existe porque o URL da API só se conhece depois do PRIMEIRO deploy —
# não pode estar escrito à mão no ficheiro (ver infra/docker/frontend.Dockerfile
# e infra/gcloud/04-deploy.sh). As outras variáveis com `$` aqui ($host,
# $proxy_host, $remote_addr, $scheme, $uri, $http_x_forwarded_proto) são do
# NGINX, não do sistema — o envsubst da imagem oficial só troca nomes que
# existam mesmo como variável de ambiente, por isso não lhes toca.
#
# Em desenvolvimento (docker-compose), API_URL=http://api:8000 (nome do
# serviço na rede do compose). Em produção (Cloud Run), API_URL é o URL
# público (https://) do serviço da API, definido no deploy.

# Esquema original do cliente: dentro do container o NGINX ouve em :80 (o
# Cloud Run termina o TLS antes), por isso $scheme é sempre "http". Quando há
# um proxy à frente (Cloud Run), o esquema real vem no cabeçalho que ele já
# pôs; caso contrário (compose), usa-se o $scheme local.
map $http_x_forwarded_proto $esquema_cliente {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # A barra final faz o NGINX remover o prefixo /api/ antes de
        # reencaminhar: /api/auth/eu -> ${API_URL}/auth/eu
        proxy_pass ${API_URL}/;

        # O URL da API pode ser https:// (Cloud Run). Um upstream HTTPS precisa
        # de SNI, senão o handshake TLS falha ou traz o certificado errado.
        # Sem efeito quando o upstream é http:// (dev/compose).
        proxy_ssl_server_name on;

        # NÃO forçar `Host: $host`. O Cloud Run encaminha o pedido pelo Host,
        # que tem de ser o do serviço da API — $proxy_host é o host retirado
        # do proxy_pass. O host público do site segue em X-Forwarded-Host
        # para quem dele precisar.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $esquema_cliente;
    }

    location / {
        try_files $uri /index.html;
    }

    # Ficheiros com hash no nome (Vite) podem ser cacheados de forma agressiva.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
